# ============================================================
# Archivo de ejemplo — copia esto a .env y completa los valores
# NUNCA subas tu .env real al repositorio
# ============================================================

# Configuración de Base de Datos PostgreSQL
POSTGRES_DB=Subasta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DB_HOST=postgres
DB_PORT=5432

# Backend Spring Boot
SERVER_PORT=8080

# JWT — genera un secreto seguro (mínimo 256 bits en hex)
# Ejemplo: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_hex_here
JWT_EXPIRATION_MS=1800000
