# ============================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO — PRODUCCIÓN OCI
# Copia este archivo a .env y asigna valores reales y seguros.
# NUNCA subas tu archivo .env real al repositorio.
# ============================================================

# Base de datos PostgreSQL
POSTGRES_DB=Subasta
# Usuario administrativo para inicialización del contenedor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_strong_admin_password_here

# Usuario exclusivo de aplicación (Principio de mínimo privilegio)
APP_DB_USER=subasta_app
APP_DB_PASSWORD=generate_strong_app_password_here

DB_HOST=postgres
DB_PORT=5432

# Backend Spring Boot
SERVER_PORT=8080

# Criptografía JWT (Generar secreto de mínimo 256 bits: openssl rand -hex 32)
JWT_SECRET=generate_with_openssl_rand_hex_32_at_least_64_chars
JWT_EXPIRATION_MS=1800000

# Configuración de Correo
# Opción 1: Brevo API vía HTTPS Puerto 443 (Recomendado para Render y Cloud)
BREVO_API_KEY=xkeysib-tu_clave_de_brevo_aqui
BREVO_SENDER_EMAIL=tu_correo_registrado_en_brevo@empresa.com
BREVO_SENDER_NAME=SUBASTA

# Opción 2: Correo SMTP tradicional (Gmail, etc.)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@empresa.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion_segura

# Almacenamiento persistente de archivos
UPLOAD_DIR=/app/uploads
